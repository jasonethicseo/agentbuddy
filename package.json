{
  "name": "agentbuddy",
  "version": "0.1.0",
  "description": "A 2000s-messenger-style buddy list for your AI coding agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentbuddy": "dist/relay.js",
    "agentbuddy-hook": "dist/hook.js"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:ui",
    "build:node": "node scripts/build-node.mjs",
    "build:ui": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "relay": "npm run build && node dist/relay.js",
    "dev": "vite",
    "demo": "vite --config vite.demo.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron dist/app/main.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
